package {
    default_applicable_licenses: ["hardware_generic_audio_license"],
}

apex {
    name: "com.android.hardware.audio.generic",
    manifest: "manifest.json",
    file_contexts: "file_contexts",
    key: "com.android.hardware.key",
    certificate: ":com.android.hardware.certificate",
    updatable: false,
    vendor: true,

    binaries: [
        "android.hardware.audio.service-aidl.generic",
        "android.hardware.audio.effect.service-aidl.generic",
    ],
    // AOSP ships the optimized effect implementations from frameworks/av here.
    // Those are only visible to hardware/interfaces, so this APEX uses the
    // software reference implementations built by this repository instead.
    native_shared_libs: [
        "libaecsw_generic",
        "libagc1sw_generic",
        "libagc2sw_generic",
        "libbassboostsw_generic",
        "libdownmixsw_generic",
        "libdynamicsprocessingsw_generic",
        "libenvreverbsw_generic",
        "libequalizersw_generic",
        "liberasersw_generic",
        "libextensioneffect_generic",
        "libhapticgeneratorsw_generic",
        "libloudnessenhancersw_generic",
        "libnssw_generic",
        "libpresetreverbsw_generic",
        "libspatializersw_generic",
        "libvirtualizersw_generic",
        "libvisualizersw_generic",
        "libvolumesw_generic",
    ],
    // The bluetooth audio VINTF fragment is deliberately absent. This APEX
    // does not bundle android.hardware.bluetooth.audio-impl; that library is
    // installed to /vendor and brings its own fragment, so declaring it here
    // too gives two providers of IBluetoothAudioProviderFactory/default and
    // checkvintf rejects the vendor manifest.
    prebuilts: [
        "android.hardware.audio.service-aidl.generic.rc",
        "android.hardware.audio.service-aidl.generic.xml",
    ],
    required: [
        "aidl_audio_set_configurations_bfbs",
        "aidl_default_audio_set_configurations_json",
        "aidl_audio_set_scenarios_bfbs",
        "aidl_default_audio_set_scenarios_json",
        "hfp_codec_capabilities_xml",
    ],
}
